  "cons": {
    "1": {
      "name": "反作用力",
      "desc": [
        "发动<span style=\"color:#FFFFFF;\">[特殊技]</span>或<span style=\"color:#FFFFFF;\">[强化特殊技]</span>，成功格挡敌人的攻击时，攻击者造成的伤害降低30%，持续15秒。",
        "<i>「力的作用是相互的，为什么还要正面撞过来？」</i>",
        "<i>「看来你没有好好计算过」</i>"
      ]
    },
    "2": {
      "name": "以守为攻",
      "desc": [
        "在<span style=\"color:#FFFFFF;\">[特殊技]</span>或<span style=\"color:#FFFFFF;\">[强化特殊技]</span>中，成功触发格挡反击时，额外造成本300%防御力的伤害。",
        "<i>不像其他熊希人，战斗时的本非常有耐心。</i>",
        "<i>因为他相信，只要做好防护，一定能等到敌人露出破绽的时刻。</i>"
      ]
    },
    "3": {
      "name": "精打细算",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2",
        "<i>担当财务负责人必须学会精打细算，用一切可用的资源强化大家和自己。</i>"
      ]
    },
    "4": {
      "name": "灵活应变",
      "desc": [
        "在<span style=\"color:#FFFFFF;\">[特殊技]</span>或<span style=\"color:#FFFFFF;\">[强化特殊技]</span>中，通过无敌效果成功格挡攻击时 ，后继反击造成的伤害提升30%。",
        "<i>出于会计的职业本能，</i>",
        "<i>本总是会根据形式，动态调整自己的对策。</i>",
        "<i>无论是账目还是对敌，务必以最小成本达到最佳效果。</i>"
      ]
    },
    "5": {
      "name": "巨细靡遗",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2",
        "<i>本敏锐的眼光不会放弃任何报表上的错误，同样也不会放过自己战斗方式上的失误，在纠错中逐渐变强。</i>"
      ]
    },
    "6": {
      "name": "野性斗志",
      "desc": [
        "在<span style=\"color:#FFFFFF;\">[强化特殊技]</span>中发动攻击或追加强力打击后，<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[冲刺攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避反击]</span>造成的失衡值提升20%，持续12秒。",
        "<i>熊希人与犬希人不同，</i>",
        "<i>并不能用食物安抚他们躁动的情绪。</i>",
        "<i>当他们发脾气时，你唯一能做的就是跑快一点，跑远一点…</i>",
        "<i>——下架书籍《做个好邻居！与希人相处的100个小窍门》</i>"
      ]
    }
  },
  "passive": {
    "name": "核心被动 / 额外能力",
    "desc": [
      "<h3>核心被动：守卫</h3>",
      "本的初始攻击力随初始防御力提升，提升效果等同于自身初始防御力的<span style=\"color:#2BAD00;\">(40%/46%/52%/60%/66%/72%/80%)</span>；",
      "在<span style=\"color:#FFFFFF;\">[强化特殊技]</span>中追加强力打击时，为全队角色提供等同于自身<span style=\"color:#2BAD00;\">(15%/17.5%/20%/22.5%/25%/27.5%/30%)</span>防御力+<span style=\"color:#2BAD00;\">(100/220/330/460/500/525/550)</span>点护盾，持续30秒。",
      "<h3>额外能力：协议合同</h3>",
      "队伍中存在与自身属性或阵营相同的角色时触发：",
      "拥有<span style=\"color:#FFFFFF;\">[核心被动：守卫]</span>施加的护盾时，角色的暴击率提升16%。"
    ]
  }
