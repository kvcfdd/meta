  "cons": {
    "1": {
      "name": "黄昏旧章",
      "desc": [
        "进入战场时，佩洛伊斯获得1000点<span style=\"color:#FFFFFF;\">[喧响值]</span>，在勘域模式中此效果180秒内最多触发一次，暴击率提升8%。",
        "<i>幽夜是黝黯的潮水，沉沦文明的原野，</i>",
        "<i>痴妄的神祇锻造灼亮的金矛，欲刺破深渊的喉管。</i>"
      ]
    },
    "2": {
      "name": "煜焰铁骑",
      "desc": [
        "发动[终结技：凯旋坦途]时回复1500点<span style=\"color:#FFFFFF;\">[喧响值]</span>，该效果180秒最多触发一次；佩洛伊斯的喧响值上限提升1000点。",
        "<i>所有被遗忘的故事与呜咽，都沉入一双眼睛的旱海；</i>",
        "<i>等待一驾烈焰灼灼的车辇，碾过无光的渊面。</i>"
      ]
    },
    "3": {
      "name": "命定枷锁",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2",
        "<i>车舆煌煌，焦土茫茫，</i>",
        "<i>天真稚子的躯壳中，却孕育燔荡生灵的暴君。</i>"
      ]
    },
    "4": {
      "name": "焚昼孽火",
      "desc": [
        "佩洛伊斯发动<span style=\"color:#FFFFFF;\">[强化特殊技：日华]</span>触发完美格挡时，立刻获得等同于自身15%生命值上限的护盾，持续12秒，重复触发刷新持续时间，持有该护盾时，佩洛伊斯造成的失衡值提升10%。",
        "<i>或许启明的灯火总要泅渡午夜，或许英雄的旅途总要踏过荆棘。</i>",
        "<i>于是弃儿漫长地将自己放逐，直到孽火将仅剩的残躯焚尽。</i>"
      ]
    },
    "5": {
      "name": "稚子禁卫",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2",
        "<i>暴君的冠冕化作缰绳，银白的铁卫与骏马，</i>",
        "<i>拱卫永远燃烧的稚子，跨过数字的牢笼与黑夜的虚言。</i>"
      ]
    },
    "6": {
      "name": "拂晓晨星",
      "desc": [
        "影画效果未揭示",
        "<i>黄昏猩红若血，黎明温柔如旧。</i>",
        "<i>晨星已从天际升起，抹去童年的泪痕，</i>",
        "<i>它的轻叹如同诗句的尾韵——</i>",
        "<i>长夜无非朝阳的序幕。</i>"
      ]
    }
  },
  "passive": [
    {
      "name": "核心被动 / 额外能力",
      "desc": [
        "<h3>核心被动：煊赫车辇</h3>",
        "进入战场时，佩洛伊斯获得30点<Term:1000018>，在勘域模式中此效果180秒内最多触发一次，且不同攻击命中敌人时回复一定<span style=\"color:#FFFFFF;\">[日珥]</span>，处于接战状态下，每秒回复0.5点<span style=\"color:#FFFFFF;\">[日珥]</span>，最多获得60点；",
        "佩洛伊斯发动不同[终结技]时，分别可获得如下效果：",
        "上分支-[终结技：万军诛绝]：获得30点[日珥]，并获得<Term:1000019>状态，[阳炎]状态下，佩洛伊斯发动[终结技]对处于失衡状态下的敌人造成的暴击伤害提升40%，[日珥]大于等于30点时，[普通攻击：天光]的第四段攻击期间长按「普通攻击」可直接衔接[普通攻击：天光]的第三段攻击，持续21秒，重复触发时刷新持续时间；",
        "下分支-[终结技：凯旋坦途]：获得<Term:1000020>状态，[耀斑]状态下，能量获得效率提升15%，造成的伤害提升<span style=\"color:#2BAD00;\">(20%/23.4%/26.8%/30.2%/33.6%/37%/40%)</span>，发动[强化特殊技]触发完美格挡时回复10点[日珥]，持续200秒，重复触发时刷新持续时间；",
        "左分支-[终结技：无拘剑势]：重击命中[浸染]状态下的敌人时，额外造成等同于<span style=\"color:#2BAD00;\">(450%/525%/600%/675%/750%/825%/900%)</span>攻击力的伤害；",
        "右分支-[终结技：永陷幽囚]：重击命中失衡敌人触发<Term:1000021>效果，额外造成等同于<span style=\"color:#2BAD00;\">(1125%/1312%/1499%/1686%/1873%/2060%/2250%)</span>攻击力的伤害，招式发动时，使所有处于失衡状态的敌人失衡持续时间提升3秒，终结一击命中时敌人失衡结束。",
        "<h3>额外能力：辉煌军势</h3>",
        "队伍中存在<span style=\"color:#FFFFFF;\">[击破]</span>或<span style=\"color:#FFFFFF;\">[支援]</span>角色时触发：",
        "佩洛伊斯的暴击伤害提升40%；",
        "发动[连携技]时回复自身300点<span style=\"color:#FFFFFF;\">[喧响值]</span>。"
      ]
    }
  ]
}