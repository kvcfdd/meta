      ]
    },
    "6": {
      "name": "炽热心流",
      "desc": [
        "发动<span style=\"color:#FFFFFF;\">[强化特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span>或<span style=\"color:#FFFFFF;\">[终结技]</span>时，「11号」获得8层充能（上限8层）；触发<span style=\"color:#FFFFFF;\">[火力镇压]</span>时，消耗1层充能，使当前招式无视目标25%<span style=\"color:#FF5521;\">火属性伤害抗性</span>。"
      ]
    }
  },
  "passive": {
    "name": "核心被动：热浪 / 额外能力：燎原",
