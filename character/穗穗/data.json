  "cons": {
    "1": {
      "name": "雨洗千山皆入画",
      "desc": [
        "<span style=\"color:#ffd12f;\">延奏技能·渌水盈盈</span>中至少消耗600点<span style=\"color:#ffd12f;\">【<u>芳菲信</u>】</span>获得的攻击提升效果，附加<span style=\"color:#ffd12f;\">【<u>异常效应</u>】</span>或造成<span style=\"color:#ffd12f;\"><u>异常效应伤害</u></span>时也可以触发。",
        "第3次<span style=\"color:#ffd12f;\"><u>翾舞</u></span>的时候获得的<span style=\"color:#ffd12f;\"><u>重明照影</u></span>的时间提升100%。",
        "<span style=\"color:#ffd12f;\">普攻·濯雨时</span>、<span style=\"color:#ffd12f;\">重击·濯雨时</span>和<span style=\"color:#ffd12f;\">【强化下落攻击·强化形态】</span>免疫打断。"
      ]
    },
    "2": {
      "name": "霞铺万顷欲流金",
      "desc": [
        "<span style=\"color:#ffd12f;\">山河水境</span>内附近队伍中所有角色触发以下效果时，使触发效果的角色暴击伤害提升50%，持续30秒：",
        "·为目标附加<span style=\"color:#ffd12f;\">【<u>光噪效应</u>】</span>、<span style=\"color:#ffd12f;\">【<u>聚爆效应</u>】</span>、<span style=\"color:#ffd12f;\">【<u>霜渐效应</u>】</span>、<span style=\"color:#ffd12f;\">【<u>风蚀效应</u>】</span>、<span style=\"color:#ffd12f;\">【<u>电磁效应</u>】</span>，或造成对应异常效应伤害。",
        "·通过技能命中消耗目标<span style=\"color:#ffd12f;\">【<u>虚湮效应</u>】</span>层数。",
        "队伍中登场角色不处于<span style=\"color:#ffd12f;\">山河水境</span>内时，该暴击伤害提升效果暂时失效。"
      ]
    },
    "3": {
      "name": "半卷疏帘邀晚照",
      "desc": [
        "施放<span style=\"color:#ffd12f;\">共鸣技能·濯雨时</span>后的一定时间内，短按<span style=\"color:#ffd12f;\">普攻</span>，将会施放<span style=\"color:#ffd12f;\">普攻·濯雨时第4段</span>。",
        "施放<span style=\"color:#ffd12f;\">共鸣技能·濯雨时</span>时，获得<span style=\"color:#ffd12f;\">点翠</span>，切换至其他角色时移除。施放<span style=\"color:#ffd12f;\">普攻·濯雨时第4段</span>时，会消耗<span style=\"color:#ffd12f;\">点翠</span>，回复自身20点协奏，并回复350点<span style=\"color:#ffd12f;\">【<u>芳菲信</u>】</span>。每25秒最多消耗1次<span style=\"color:#ffd12f;\">点翠</span>。"
      ]
    },
    "4": {
      "name": "一桁秋山共我吟",
      "desc": [
        "<span style=\"color:#ffd12f;\"><u>润物</u></span>和<span style=\"color:#ffd12f;\"><u>春生</u></span>造成的治疗量提升50%。"
      ]
    },
    "5": {
      "name": "愿乘东风千万里",
      "desc": [
        "<span style=\"color:#ffd12f;\">普攻·濯雨时</span>和<span style=\"color:#ffd12f;\">重击·濯雨时</span>的伤害倍率提升100%。"
      ]
    },
    "6": {
      "name": "不负江山锦绣心",
      "desc": [
        "<span style=\"color:#ffd12f;\">变奏技能·泠泠漱玉声</span>和<span style=\"color:#ffd12f;\">共鸣技能·醒春潮</span>的暴击伤害提升500%。"
      ]
    }
  },
  "passive": [
    {
      "name": "延奏技能: 渌水盈盈",
      "desc": [
        "队伍中的角色全伤害加深25%，持续30秒。",
        "退出<span style=\"color:#ffd12f;\"><u>濯雨时</u></span>，并消耗所有<span style=\"color:#ffd12f;\">【<u>芳菲信</u>】</span>，若当前场上存在<span style=\"color:#ffd12f;\"><u>山河水境</u></span>，则穗穗进入<span style=\"color:#ffd12f;\"><u>仙游碧落</u></span>状态，且根据消耗的<span style=\"color:#ffd12f;\">【<u>芳菲信</u>】</span>解锁以下效果：",
        "消耗至少0点<span style=\"color:#ffd12f;\">【<u>芳菲信</u>】</span>：",
        "·附近队伍中所有角色获得6秒的<span style=\"color:#ffd12f;\"><u>重明照影</u></span>。持有<span style=\"color:#ffd12f;\"><u>重明照影</u></span>的角色抗打断提升。",
        "消耗至少200点<span style=\"color:#ffd12f;\">【<u>芳菲信</u>】</span>：",
        "·<span style=\"color:#ffd12f;\"><u>山河水境</u></span>存在时，<span style=\"color:#ffd12f;\"><u>仙游碧落</u></span>至第6秒时可以进行第1次<span style=\"color:#ffd12f;\"><u>翾舞</u></span>。",
        "消耗至少400点<span style=\"color:#ffd12f;\">【<u>芳菲信</u>】</span>：",
        "·<span style=\"color:#ffd12f;\"><u>山河水境</u></span>内登场角色获得额外效果：若持有<span style=\"color:#ffd12f;\"><u>重明照影</u></span>，则造成的伤害提升：穗穗自身共鸣效率大于200%时，每超过1%的共鸣效率计算为0.2%的伤害提升，上限12%。",
        "·<span style=\"color:#ffd12f;\"><u>山河水境</u></span>存在时，<span style=\"color:#ffd12f;\"><u>仙游碧落</u></span>至第12秒时可以进行第2次<span style=\"color:#ffd12f;\"><u>翾舞</u></span>。",
        "消耗至少600点<span style=\"color:#ffd12f;\">【<u>芳菲信</u>】</span>：",
        "·第1次<span style=\"color:#ffd12f;\"><u>翾舞</u></span>时，<span style=\"color:#ffd12f;\"><u>山河水境</u></span>内附近队伍中登场角色获得额外效果：施放延奏技能时，使下一个角色获得效果：自身通过技能命中消耗敌方异常层数时，攻击提升：穗穗自身共鸣效率大于200%时，每超过0.12%的共鸣效率计算为0.1%的攻击提升，上限50%，持续6秒，该角色登场14秒时移除所有效果，若切换至其他角色则该效果提前结束。",
        "·<span style=\"color:#ffd12f;\"><u>山河水境</u></span>存在时，<span style=\"color:#ffd12f;\"><u>仙游碧落</u></span>至第18秒时可以进行第3次<span style=\"color:#ffd12f;\"><u>翾舞</u></span>。",
        "<h3>仙游碧落</h3>",
        "<span style=\"color:#ffd12f;\"><u>仙游碧落</u></span>状态期间，穗穗不是队伍中登场角色时，会依附于<span style=\"color:#ffd12f;\">山河水境</span>之上进行飞仙演舞，并根据施放<span style=\"color:#ffd12f;\">延奏技能·渌水盈盈</span>时消耗的<span style=\"color:#ffd12f;\">【芳菲信】</span>，每隔一定时间进行一次<span style=\"color:#ffd12f;\"><u>翾舞</u></span>。",
        "穗穗为队伍中登场角色时，暂停<span style=\"color:#ffd12f;\"><u>仙游碧落</u></span>。",
        "<h3>翾舞</h3>",
        "每次进行<span style=\"color:#ffd12f;\"><u>翾舞</u></span>时，使附近队伍中所有角色获得6秒的<span style=\"color:#ffd12f;\"><u>重明照影</u></span>，为<span style=\"color:#ffd12f;\"><u>山河水境</u></span>内敌方目标附加一层<span style=\"color:#ffd12f;\">【<u>霜渐效应</u>】</span>，为<span style=\"color:#ffd12f;\"><u>山河水境</u></span>内附近队伍中登场角色回复生命值。"
      ]
    },
    {
      "name": "谐度破坏: 谐度破坏·臂铠",
      "desc": [
        "目标<span style=\"color:#ffd12f;\">【偏谐值】</span>满时，可对其施放<span style=\"color:#ffd12f;\"><u>【谐度破坏】</u></span>。"
      ]
    },
    {
      "name": "近水纳天光",
      "desc": [
        "<span style=\"color:#ffd12f;\"><u>润物</u></span>被消耗时，该角色还会获得10层<span style=\"color:#ffd12f;\"><u>春生</u></span>，上限10层。拥有<span style=\"color:#ffd12f;\"><u>春生</u></span>的角色如果当前生命值未达生命上限，则每2秒消耗1层<span style=\"color:#ffd12f;\"><u>春生</u></span>，穗穗为其回复62+0.34%穗穗生命上限的生命值。",
        "<span style=\"color:#ffd12f;\">共鸣技能·醒春潮</span>和<span style=\"color:#ffd12f;\">变奏技能·泠泠漱玉声</span>命中目标时，额外回复18点协奏和13点共鸣能量，并使该次攻击的暴击率提升80%，造成的冷凝伤害提升240%。每25秒最多触发1次。"
      ]
    },
    {
      "name": "浮光跃金处",
      "desc": [
        "队伍中有穗穗以外的角色受到致死伤害时，此次伤害不会使该角色倒下并获得穗穗当前50%生命值，穗穗扣除等量生命值。穗穗最少保留1点生命值。该效果每10分钟可触发一次。"
      ]
    }
