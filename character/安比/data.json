  "cons": {
    "1": {
      "name": "快充模式",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>第四段斩击命中敌人时，安比的能量获得效率提升12%，持续30秒。",
        "<i>「快充一分钟，战斗半小时！」</i>",
        "<i>为武器加装拓展功能模块的专家是这么保证的——</i>",
        "<i>使用效果也确实符合他的宣言。</i>"
      ]
    },
    "2": {
      "name": "精准放电",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击：落雷]</span>命中处于失衡状态下的敌人时，招式造成的伤害提升30%；<span style=\"color:#FFFFFF;\">[强化特殊技]</span>命中未处于失衡状态下的敌人时，招式造成的失衡值提升10%。",
        "<i>「触电了，就会晕倒。」</i>",
        "<i>少女淡淡的望着面前轰然昏倒的敌人，补了一句：</i>",
        "<i>「电影里都是这么演的。」</i>"
      ]
    },
    "3": {
      "name": "训练有素",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2",
        "<i>奔跑、挥刀、动若雷霆。少女不是探索空洞的生手，而是精于此道的专家。</i>"
      ]
    },
    "4": {
      "name": "电荷传导",
      "desc": [
        "发动<span style=\"color:#FFFFFF;\">[连携技]</span>或<span style=\"color:#FFFFFF;\">[终结技]</span>时，为后场电属性角色回复3点能量；安比每拥有12%能量获得效率，回复量额外提升2点，最多额外提升6点。",
        "<i>单打独斗不是长久之计，老练的盗洞客还会在战斗中适时为队友创造机会。</i>"
      ]
    },
    "5": {
      "name": "街头经验",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2",
        "<i>狡兔屋的工作不仅能提升心理素质，还能（被迫）提升身体素质。</i>"
      ]
    },
    "6": {
      "name": "充能电场",
      "desc": [
        "发动<span style=\"color:#FFFFFF;\">[强化特殊技]</span>时，安比获得8层充能（上限8层）；<span style=\"color:#FFFFFF;\">[普通攻击]</span>或<span style=\"color:#FFFFFF;\">[冲刺攻击]</span>命中敌人时，消耗1层充能，使当前招式造成的伤害提升45%。",
        "<i>闪烁的电光在少女的指尖跳跃。</i>",
        "<i>少女抬起头，眼里盛着超出外貌年龄的坚毅。</i>",
        "<i>或许终有一日，她将成为掌控这须臾电光的人。</i>"
      ]
    }
  },
