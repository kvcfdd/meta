      ]
    },
    "6": {
      "name": "丰收的喜悦",
      "desc": [
        "重击<span style=\"color:#ffd12f;\">星星花绽放</span>及空中攻击<span style=\"color:#ffd12f;\">星星花绽放</span>的伤害提升20%，命中目标时触发1次协同攻击，并为附近队伍中所有角色回复生命值，此次协同攻击伤害和回复生命值等同于共鸣解放<span style=\"color:#ffd12f;\">光合标记</span>。"
      ]
    }
  },
