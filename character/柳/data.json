  "cons": {
    "1": {
      "name": "知己知彼",
      "desc": [
        "队伍中任意角色对敌人施加属性异常效果时，月城柳会获得1层<span style=\"color:#FFFFFF;\">[洞悉]</span>，持续15秒，最多叠加3层，重复触发时刷新持续时间；受到敌方攻击时，月城柳将消耗1层<span style=\"color:#FFFFFF;\">[洞悉]</span>并获得无敌效果，持续1秒；拥有1层或以上<span style=\"color:#FFFFFF;\">[洞悉]</span>时，月城柳的异常精通提升80点。"
      ]
    },
    "2": {
      "name": "卓越适应性",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[强化特殊技]</span>中，快速突刺累积的<span style=\"color:#2EB6FF;\">电属性异常积蓄值</span>提升20%；快速突刺命中敌人时，保持长按「特殊攻击」按键，可以额外消耗10点能量，再次发动突刺攻击，能量不足或停止长按后将自动衔接下落攻击；下落攻击命中处于属性异常状态下的敌人并触发<span style=\"color:#FFFFFF;\">[极性紊乱]</span>效果时，对目标造成的伤害倍率提升至原本<span style=\"color:#FFFFFF;\">[紊乱]</span>效果的20%，每额外发动一次突刺攻击，该伤害倍率额外提升15%，伤害倍率额外提升效果最多触发2次。"
      ]
    },
    "3": {
      "name": "月城氏管理学",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2"
      ]
    },
    "4": {
      "name": "掌棋者",
      "desc": [
        "月城柳对敌人造成属性异常伤害时，会为其施加<span style=\"color:#FFFFFF;\">[识破]</span>效果，持续15秒；处于<span style=\"color:#FFFFFF;\">[识破]</span>效果下的敌人受到攻击时，本次攻击的穿透率提升16%。"
      ]
    },
    "5": {
      "name": "鬼「妈妈」",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2"
      ]
    },
    "6": {
      "name": "非人之血",
      "desc": [
        "在<span style=\"color:#FFFFFF;\">[强化特殊技]</span>中发动突刺攻击后，<span style=\"color:#FFFFFF;\">[森罗万象]</span>状态的持续时间提升至30秒，状态持续期间，<span style=\"color:#FFFFFF;\">[强化特殊技]</span>造成的伤害提升20%；<span style=\"color:#FFFFFF;\">[卓越适应性]</span>中，<span style=\"color:#FFFFFF;\">[极性紊乱]</span>伤害倍率额外提升效果的触发次数上限提升至4次，前4次额外发动突刺攻击时所需的能量消耗减半。"
      ]
    }
  },
  "passive": {
    "name": "核心被动：月蚀 / 额外能力：月相",
    "desc": [
      "<h3>核心被动：月蚀</h3>",
      "月城柳发动<span style=\"color:#FFFFFF;\">[强化特殊技]</span>后，队伍中任意角色对敌人施加<span style=\"color:#FFFFFF;\">[紊乱]</span>效果时，<span style=\"color:#FFFFFF;\">[紊乱]</span>效果的伤害倍率提升125%/145%/166%/188%/208%/230%，持续15秒；<span style=\"color:#FFFFFF;\">[强化特殊技]</span>命中敌人时，月城柳对目标造成的<span style=\"color:#2EB6FF;\">电属性伤害</span>提升10%/11.6%/13.3%/15%/16.6%/18.3%，持续15秒。",
      "<h3>额外能力：月相</h3>",
      "队伍中存在其他<span style=\"color:#FFFFFF;\">[异常]</span>角色或与自身属性相同的角色时触发：",
      "架势切换后，月城柳发动<span style=\"color:#FFFFFF;\">[普通攻击：夜见尊神乐]</span>命中敌人时累积的<span style=\"color:#2EB6FF;\">电属性异常积蓄值</span>提升45%，持续8秒。"
    ]
  }
}