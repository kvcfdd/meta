  "cons": {
    "1": {
      "name": "穿行于荒芜长廊",
      "desc": [
        "千咲施放<span style=\"color:#ffd12f;\">锯环·疾攻</span>、<span style=\"color:#ffd12f;\">锯环·终结</span>、<span style=\"color:#ffd12f;\">电锯模式·闪避反击</span>期间，免疫打断。",
        "千咲附加<span style=\"color:#ffd12f;\"><u>虚无绞痕</u></span>时，触发下述效果：",
        "·自身攻击提升30%，持续15秒。",
        "·对目标造成61803点固定<span style=\"color:#e649a6;\">湮灭伤害</span>，最多可将目标生命扣除至61.80%，同一目标最多可受到1次该伤害。此次伤害为普攻伤害，不受伤害加成影响。"
      ]
    },
    "2": {
      "name": "织作牵绊的弦网",
      "desc": [
        "造成伤害无视目标10%湮灭伤害抗性。",
        "附近队伍中的角色处于<span style=\"color:#ffd12f;\"><u>虚湮之线</u></span>状态时，全属性伤害加成提升50%。"
      ]
