  "cons": {
    "1": {
      "name": "授以舟楫渡潮生",
      "desc": [
        "施放<span style=\"color:#ffd12f;\">共鸣解放·转相</span>时，心获得2层<span style=\"color:#ffd12f;\">敛华障</span>，可叠加2层，转变为<span style=\"color:#ffd12f;\">应世相</span>时清除全部层数。心受到敌方怪物攻击造成的伤害时，可消耗1层<span style=\"color:#ffd12f;\">敛华障</span>，使自身免疫打断且受到的伤害降低60%，持续1秒，该效果每1秒可触发1次。",
        "处于<span style=\"color:#ffd12f;\">共鸣模态·同奏</span>时：",
        "<span style=\"color:#ffd12f;\">变奏技能·应世相·诸相同奏</span>、<span style=\"color:#ffd12f;\">变奏技能·照世相·诸相同奏</span>的伤害倍率提升15%。且每有1层<span style=\"color:#ffd12f;\">【<u>同奏增益</u>】</span>，使<span style=\"color:#ffd12f;\">变奏技能·应世相·诸相同奏</span>、<span style=\"color:#ffd12f;\">变奏技能·照世相·诸相同奏</span>的伤害倍率额外提升10%，至多叠加4层。",
        "处于<span style=\"color:#ffd12f;\">共鸣模态·电磁</span>时：",
        "心进入战斗状态时，若<span style=\"color:#ffd12f;\"><u>霆心域</u></span>层数不足50层，则增加至50层，每4秒可触发一次。",
        "<span style=\"color:#ffd12f;\">共鸣回路·共鸣技能·照世相</span>命中目标消耗5层<span style=\"color:#ffd12f;\"><u>霆心域</u></span>触发<span style=\"color:#ffd12f;\">【<u>电磁效应</u>】</span>伤害的倍率系数提升至260%，一次性消耗全部剩余<span style=\"color:#ffd12f;\"><u>霆心域</u></span>触发<span style=\"color:#ffd12f;\">【<u>电磁效应</u>】</span>伤害的倍率系数提升至52%。"
      ]
    },
    "2": {
      "name": "一念初醒问此身",
      "desc": [
        "<span style=\"color:#ffd12f;\">应世相·步红尘</span>和<span style=\"color:#ffd12f;\">应世相·镇红尘</span>的伤害倍率提升60%。",
