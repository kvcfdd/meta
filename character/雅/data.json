  "cons": {
    "1": {
      "name": "雪上加霜",
      "desc": [
        "在<span style=\"color:#FFFFFF;\">[霜月架势]</span>期间，每消耗1点<span style=\"color:#FFFFFF;\">[落霜]</span>，<span style=\"color:#FFFFFF;\">[普通攻击：霜月]</span>将无视目标6%防御力，最多叠加6层，退出<span style=\"color:#FFFFFF;\">[霜月架势]</span>后增益效果结束；在<span style=\"color:#FFFFFF;\">[普通攻击：霜月]</span>中进行三段蓄力，斩击命中处于<span style=\"color:#FFFFFF;\">[霜灼]</span>状态下的敌人时，可以立即消除目标的<span style=\"color:#FFFFFF;\">[霜灼]</span>状态，并使全队角色属性异常积蓄效率提升20%，持续10秒。"
      ]
    },
    "2": {
      "name": "吐纳法",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击：风花]</span>和<span style=\"color:#FFFFFF;\">[闪避反击]</span>造成的伤害提升30%；第五段<span style=\"color:#FFFFFF;\">[普通攻击：风花]</span>最后一击命中敌人时，星见雅获得1点<span style=\"color:#FFFFFF;\">[落霜]</span>；进入战场时，星见雅立刻获得6点<span style=\"color:#FFFFFF;\">[落霜]</span>，自身暴击率提升15%。"
      ]
    },
    "3": {
      "name": "武者修养",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2"
      ]
    },
    "4": {
      "name": "皲裂",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[霜灼·破]</span>造成的伤害提升30%，触发<span style=\"color:#FFFFFF;\">[霜灼·破]</span>时，星见雅额外获得250点喧响值。"
      ]
    },
    "5": {
      "name": "纪念日",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2"
      ]
    },
    "6": {
      "name": "天资卓越",
      "desc": [
        "在<span style=\"color:#FFFFFF;\">[霜月架势]</span>期间，星见雅将获得<span style=\"color:#FFFFFF;\">[极意]</span>效果，使<span style=\"color:#FFFFFF;\">[普通攻击：霜月]</span>造成的伤害提升30%，获得<span style=\"color:#FFFFFF;\">[极意]</span>效果后，消耗<span style=\"color:#FFFFFF;\">[落霜]</span>时，星见雅会根据当前蓄力段数，自动拔刀向前方发动强力斩击；在<span style=\"color:#FFFFFF;\">[落霜]</span>耗尽前，拔刀斩击不会打断<span style=\"color:#FFFFFF;\">[霜月架势]</span>下的蓄力进度；在一次<span style=\"color:#FFFFFF;\">[霜月架势]</span>期间，最多连续发动3次拔刀斩击。"
      ]
    }
  },
  "passive": {
    "name": "核心被动：寒炎 / 额外能力：同沐霜雪",
    "desc": [
      "<h3>核心被动：寒炎</h3>",
      "星见雅对敌人造成<span style=\"color:#98EFF0;\">烈霜伤害</span>时，将会为目标附着<span style=\"color:#FFFFFF;\">[冰焰]</span>，持续30秒；对附着<span style=\"color:#FFFFFF;\">[冰焰]</span>的敌人累积<span style=\"color:#98EFF0;\">烈霜异常积蓄值</span>时，会基于星见雅暴击率的100%提升<span style=\"color:#98EFF0;\">烈霜异常积蓄效率</span>，最多提升80%；星见雅累积<span style=\"color:#98EFF0;\">烈霜异常积蓄值</span>时，具有独立的属性异常积蓄槽，随之触发的<span style=\"color:#98EFF0;\">[冻结]</span>、<span style=\"color:#98EFF0;\">[碎冰]</span>和<span style=\"color:#98EFF0;\">[霜寒]</span>效果，可以与包括<span style=\"color:#98EFF0;\">冰属性异常效果</span>在内的其他属性异常效果互相结算<span style=\"color:#FFFFFF;\">[紊乱]</span>；",
      "星见雅对附着<span style=\"color:#FFFFFF;\">[冰焰]</span>的敌人施加<span style=\"color:#98EFF0;\">[霜寒]</span>效果时，将会消除<span style=\"color:#FFFFFF;\">[冰焰]</span>并触发<span style=\"color:#FFFFFF;\">[霜灼·破]</span>，对目标造成星见雅750%/875%/1000%/1125%/1250%/1375%攻击力的<span style=\"color:#98EFF0;\">烈霜伤害</span>，同时使目标进入<span style=\"color:#FFFFFF;\">[霜灼]</span>状态；<span style=\"color:#FFFFFF;\">[霜灼]</span>状态下，所有单位对目标累积的属性异常积蓄值提升14%/15%/16%/17%/18%/19%，但星见雅无法再次为其附着<span style=\"color:#FFFFFF;\">[冰焰]</span>；<span style=\"color:#FFFFFF;\">[霜灼]</span>状态将会随本次<span style=\"color:#98EFF0;\">[霜寒]</span>效果一起结束，状态持续期间，对敌人重新施加属性异常效果可以覆盖<span style=\"color:#98EFF0;\">[霜寒]</span>并消除<span style=\"color:#FFFFFF;\">[霜灼]</span>；",
      "触发<span style=\"color:#FFFFFF;\">[霜灼·破]</span>时，星见雅获得1点<span style=\"color:#FFFFFF;\">[落霜]</span>，10秒内最多触发一次。",
      "<h3>额外能力：同沐霜雪</h3>",
      "队伍中存在<span style=\"color:#FFFFFF;\">[支援]</span>角色或与自身阵营相同的角色或其他<span style=\"color:#FFFFFF;\">[异常]</span>角色时触发：",
      "<span style=\"color:#FFFFFF;\">[普通攻击：霜月]</span>造成的伤害提升60%；队伍中任意角色触发<span style=\"color:#FFFFFF;\">[紊乱]</span>效果时，星见雅获得2点<span style=\"color:#FFFFFF;\">[落霜]</span>，且在下一次<span style=\"color:#FFFFFF;\">[霜月架势]</span>期间，<span style=\"color:#FFFFFF;\">[普通攻击：霜月]</span>将无视目标30%<span style=\"color:#98EFF0;\">冰属性伤害抗性</span>。"
    ]
  }
}