  "cons": {
    "1": {
      "name": "「意气风发」",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击：甲乙矢]</span>中，<span style=\"color:#FFFFFF;\">[电囚]</span>效果的叠加层数上限提升至14层；<span style=\"color:#FFFFFF;\">[电壶]</span>被激活时，将会向目标连续发射2支<span style=\"color:#FFFFFF;\">[甲乙矢]</span>。"
      ]
    },
    "2": {
      "name": "挥霍",
      "desc": [
        "发动<span style=\"color:#FFFFFF;\">[连携技]</span>或<span style=\"color:#FFFFFF;\">[终结技]</span>时，悠真获得7层<span style=\"color:#FFFFFF;\">[电掣]</span>，最多叠加7层；拥有<span style=\"color:#FFFFFF;\">[电掣]</span>时，<span style=\"color:#FFFFFF;\">[冲刺攻击：飞弦·斩]</span>造成的伤害提升50%；<span style=\"color:#FFFFFF;\">[冲刺攻击：飞弦·斩]</span>结束后，消耗1层<span style=\"color:#FFFFFF;\">[电掣]</span>。"
      ]
    },
    "3": {
      "name": "白色谎言",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2"
      ]
    },
    "4": {
      "name": "偶有充盈",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[电囚]</span>效果的持续时间提升至20秒；<span style=\"color:#FFFFFF;\">[冲刺攻击：飞弦·斩]</span>命中敌人时，悠真获得30点喧响值，同一招式内最多触发一次；发动<span style=\"color:#FFFFFF;\">[终结技]</span>时，将为场上所有敌人施加满层<span style=\"color:#FFFFFF;\">[电囚]</span>效果。"
      ]
    },
    "5": {
