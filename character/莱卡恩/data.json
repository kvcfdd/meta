    "1": {
      "name": "满月蓄势",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[强化特殊技：狂猎时刻]</span>命中敌人时，招式造成的失衡值提升12%，8秒内最多触发一次；在<span style=\"color:#FFFFFF;\">[强化特殊技：狂猎时刻]</span>中完成蓄力时，该增益效果额外提升10%。"
      ]
    },
    "2": {
      "name": "能量回馈",
      "desc": [
        "使敌人失衡或触发队友的<span style=\"color:#FFFFFF;\">[连携技]</span>时，莱卡恩回复5点能量，1秒内最多触发一次。"
      ]
    },
    "3": {
      "name": "执事教养",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2"
      ]
    },
    "4": {
      "name": "保持风度",
      "desc": [
        "在<span style=\"color:#FFFFFF;\">[普通攻击]</span>或<span style=\"color:#FFFFFF;\">[特殊技]</span>的发动期间受到敌方攻击时，",
        "莱卡恩立刻获得等同于自身7.5%生命值上限的护盾，持续15秒，",
        "护盾持续期间抗打断等级提升，15秒内最多触发一次。"
      ]
    },
    "5": {
      "name": "头狼本色",
      "desc": [
        "<span style=\"color:#FFFFFF;\">[普通攻击]</span>、<span style=\"color:#FFFFFF;\">[闪避]</span>、<span style=\"color:#FFFFFF;\">[支援技]</span>、<span style=\"color:#FFFFFF;\">[特殊技]</span>、<span style=\"color:#FFFFFF;\">[连携技]</span> 技能等级+2"
      ]
    },
    "6": {
      "name": "冷酷猎手",
      "desc": [
        "蓄力攻击命中敌人时，莱卡恩对目标造成的伤害提升10%，最多叠加5层，持续12秒；同一招式内最多叠加1层效果，重复触发时刷新持续时间。"
      ]
    }
  },
  "passive": {
    "name": "核心被动：金属狼足 / 额外能力：优雅猎群",
    "desc": [
      "<h3>核心被动：金属狼足</h3>",
      "莱卡恩在<span style=\"color:#FFFFFF;\">[普通攻击]</span>中完成蓄力时，招式造成的失衡值提升40%/46.6%/53.3%/60%/66.6%/73.3%；",
      "<span style=\"color:#FFFFFF;\">[强化特殊技：狂猎时刻]</span>或<span style=\"color:#FFFFFF;\">[支援突击：复仇反扑]</span>命中敌人时，目标的<span style=\"color:#98EFF0;\">冰属性伤害抗性</span>降低25%，持续30秒。",
      "<h3>额外能力：优雅猎群</h3>",
      "队伍中存在与自身属性或阵营相同的角色时触发：",
      "莱卡恩攻击命中处于失衡状态下的敌人时，目标的失衡易伤倍率提升35%。"
    ]
  }
